on post-fs-data
    mkdir /data/vendor/nfc 0770 nfc nfc
    mkdir /data/vendor/nfc/param 0770 nfc nfc
    mkdir /data/vendor/nfc_socket 0770 nfc nfc
    mkdir /data/vendor/secure_element 0770 secure_element secure_element
    setprop vendor.nfc.data_ready 1

on property:vendor.nfc.data_ready=1 && property:vendor.all.modules.ready=1 && property:ro.boot.product.hardware.sku=c3un
    start vendor.nfc_selector

on property:vendor.nfc.data_ready=1 && property:vendor.all.modules.ready=1 && property:ro.boot.product.hardware.sku=c3upg
    start vendor.nfc_selector

service vendor.nfc_selector /vendor/bin/sh /vendor/bin/init.nfc-select.sh
    class core
    user root
    group root
    seclabel u:r:vendor_nfc_select:s0
    disabled
    oneshot

on property:vendor.nfc.chip=pn557
    start vendor.nfc_hal_service

on property:vendor.nfc.chip=sn110x
    start vendor.nfc_hal_service

on property:vendor.nfc.chip=thn31
    start nfc_hal_service.tms.aidl

service vendor.nfc_hal_service /vendor/bin/hw/android.hardware.nfc-service.nxp
    class hal
    user nfc
    group nfc drmrpc system
    interface aidl android.hardware.nfc.INfc/default
    disabled
    override

service nfc_hal_service.tms.aidl /vendor/bin/hw/android.hardware.nfc-service-tms
    class hal
    user nfc
    group nfc
    interface aidl android.hardware.nfc.INfc/default
    seclabel u:r:hal_nfc_default:s0
    disabled
